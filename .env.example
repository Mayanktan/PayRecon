# Copy this file to .env and choose your own passwords:
#   cp .env.example .env
# (run-demo.sh creates .env with random passwords automatically if it is missing)
#
# .env is git-ignored: real passwords never go into source code or git.

MYSQL_ROOT_PASSWORD=change-me-root
PAYRECON_MYSQL_USER=payrecon
PAYRECON_MYSQL_PASSWORD=change-me

# Optional overrides (defaults shown)
# PAYRECON_MYSQL_URL=jdbc:mysql://localhost:3307/payrecon
# PAYRECON_MONGO_URI=mongodb://localhost:27017
# PAYRECON_MONGO_DB=payrecon
# PAYRECON_HIVE_CONTAINER=payrecon-hive
# PAYRECON_DATA_DIR=./data
# PAYRECON_API_PORT=8090
